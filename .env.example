# Artist values saved in admin take priority; these are fallbacks. Restart after env changes.
NEXT_PUBLIC_ARTIST_NAME=
NEXT_PUBLIC_ARTIST_ALIAS=
NEXT_PUBLIC_ARTIST_INSTAGRAM_URL=
NEXT_PUBLIC_ARTIST_TELEGRAM_URL=
NEXT_PUBLIC_ARTIST_EMAIL=
# Demo is visible to visitors. Set false only after replacing example works/prices.
NEXT_PUBLIC_DEMO_MODE=true
DATABASE_URL=postgresql://sophie:sophie_local_only@127.0.0.1:54329/sophie
# Local development uses DATABASE_URL. Supabase preview uses a separate ignored file;
# see docs/deploy/SUPABASE.md for credentials and verified TLS configuration.
DATABASE_TARGET=local
STORAGE_TARGET=local
PAYLOAD_SECRET=
# Optional Google sign-in through Supabase Auth; Google client secret stays in Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_AUTH_ORIGIN=
# The seed script creates an admin only when these are provided; never commit them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
