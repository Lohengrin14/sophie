# Restart the dev server after changing artist details. Empty links are hidden.
NEXT_PUBLIC_ARTIST_NAME=
NEXT_PUBLIC_ARTIST_ALIAS=
NEXT_PUBLIC_ARTIST_INSTAGRAM_URL=
NEXT_PUBLIC_ARTIST_TELEGRAM_URL=
NEXT_PUBLIC_ARTIST_EMAIL=
# Demo is visible to visitors. Set false only after replacing example works/prices.
NEXT_PUBLIC_DEMO_MODE=true
DATABASE_URL=postgresql://sophie:sophie_local_only@127.0.0.1:54329/sophie
PAYLOAD_SECRET=
# The seed script creates an admin only when these are provided; never commit them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
