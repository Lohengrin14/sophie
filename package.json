{
  "name": "sophie-artist-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "test:studio": "node --env-file=.env.local scripts/studio-smoke.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:layout": "tsx --env-file=.env.local scripts/seed-layout.ts",
    "payload": "payload",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "test:access": "node --env-file=.env.local scripts/access-smoke.mjs",
    "db:preview:check": "tsx scripts/preview-db.ts check",
    "db:preview:status": "tsx scripts/preview-db.ts status",
    "db:preview:migrate": "tsx scripts/preview-db.ts migrate",
    "test:migrations": "node scripts/migration-smoke.mjs",
    "test:google-auth": "node scripts/migration-smoke.mjs --google-auth",
    "test:artwork-prices": "node scripts/migration-smoke.mjs --artwork-prices",
    "test:artwork-materials": "node scripts/migration-smoke.mjs --artwork-materials",
    "storage:preview:check": "tsx scripts/storage-check.ts",
    "preview:dev": "tsx scripts/preview-app.ts dev",
    "test:storage:preview": "tsx scripts/preview-app.ts storage-test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@fontsource/lora": "^5.2.6",
    "@fontsource/manrope": "^5.2.8",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@supabase/supabase-js": "2.118.0",
    "graphql": "^16.11.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "payload": "3.92.1",
    "pg": "8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "node": "24.22.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
